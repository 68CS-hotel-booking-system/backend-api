# Copy this file to .env and load it as environment variables in your IDE or shell.
SERVER_PORT=8080

# PostgreSQL. Create the database and provide your own credentials.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hotel_booking
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password
AUTH_JWT_SECRET_BASE64=replace_with_base64_of_32_random_bytes
