# ==================== SERVER ====================
SERVER_PORT=8080

# ==================== DATABASE ====================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hotel_booking
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# ==================== JWT ====================
# Thay bằng Base64 của ít nhất 32 byte ngẫu nhiên.
AUTH_JWT_SECRET_BASE64=replace_with_generated_base64_secret

# ==================== EMAIL LOCAL — MAILPIT ====================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false

# SMTP thật (Resend): smtp.resend.com:587, username=resend,
# password là API key; bật cả ba cờ auth/STARTTLS phía trên.
# AUTH_MAIL_FROM phải thuộc domain đã xác minh.

# ==================== AUTH ====================
AUTH_MAIL_FROM=noreply@hotel.test
AUTH_VERIFICATION_URL=http://localhost:5173/verify-email
AUTH_PASSWORD_RESET_URL=http://localhost:5173/reset-password
AUTH_COOKIE_SECURE=false
